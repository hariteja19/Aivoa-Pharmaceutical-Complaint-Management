# Backend Settings
PROJECT_NAME="AIVOA Pharmaceutical Complaint Management System"
ENV="development"
PORT=8000

# Database Configuration
# Primary PostgreSQL: postgresql://postgres:postgres@localhost:5432/aivoa_db
# Fallback SQLite (Zero-setup local dev/test): sqlite:///./aivoa.db
DATABASE_URL="sqlite:///./aivoa.db"

# AI / Groq API Configuration
# Get your API key from https://console.groq.com/
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="gemma2-9b-it"

# CORS Configuration
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
